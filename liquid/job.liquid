{% endcomment %}










































{% page_required_header %}
<script>console.log('{{ job.external_id }}');</script>

{% comment %}set is_job_details variable{% endcomment %}
{% if request_path contains '/referrals/' %}
    {% capture is_referral_page %}true{% endcapture %}
{% endif %}
{% if root_url contains 'internal' %}
    {% if job and is_referral_page == 'true' %}
        {% capture is_job_details %}false{% endcapture %}
    {% else %}
        {% capture is_job_details %}true{% endcapture %}
    {% endif %}
{% endif %}

{% unless root_url contains 'ttcportals.com' or root_url contains 'internal' or root_url contains 'agency' %}
    {% if job.active? and is_referral_page != 'true' %}
        <script type="application/ld+json">
            {
                "@context" : "http://schema.org/",
                "@type" : "JobPosting",
                "title" : "{{ job.title | escape_javascript }}",
                "description" : "{{ job.description | escape_javascript | replace: "\'","'" | replace: "\$","$" }}",
                "identifier": {
                    "@type": "PropertyValue",
                    "name": "Vertex Companies",
                    "value": "{{ job.external_id }}"
                },
                "hiringOrganization" : {
                    "@type" : "Organization",
                    "name" : "Vertex Companies",
                    "logo" : "{{ root_url }}system/production/assets/511473/original/vertex__icon.png"
                },
                "jobLocation" : {
                    "@type" : "Place",
                    "address" : {
                        "@type" : "PostalAddress",
                        "streetAddress" : "{{ job.location.street | escape_javascript }}",
                        "addressLocality" : "{{ job.location.city | escape_javascript }}",
                        "addressRegion" : "{{ job.location.state_prov | escape_javascript }}",
                        "postalCode" : "{{ job.location.postal_code | escape_javascript }}",
                        "addressCountry": "{{ job.location.country | escape_javascript }}"
                    }
                },
                {% if job.remote_work_label != blank %}"jobLocationType": "{{ job.remote_work_label }}",{% endif %}
                "datePosted" : "{{ job.updated_at | date: "%Y-%m-%d" }}",
                "employmentType": "{{ job.cfm3 }}",{%- comment -%}cfm3is JobType{%- endcomment -%}
                "directApply": true
            }
        </script>
    {% endif %}
{% endunless %}

{% if visitor.frequent_job_searches.total_entries > 0 or visitor.recent_job_searches.total_entries > 0 or visitor.recent_jobs.total_entries > 0 %}
    {% capture has_sidebar %}true{% endcapture %}
{% endif %}

{% if is_job_details == 'false' %}
    {% unless job.active? %}
        {% redirect_temporary '/search/jobs?ns_inactive_job=1' %}
    {% endunless %}
{% endif %}

<div id="apply-top" class="js hide">
    {% if job.active? %}
        {% if agency %}
            {{ job | link_to_apply:"Submit Candidate", agency }}
        {% else %}
            {{ job | link_to_apply:"Apply Now" }}
        {% endif %}
    {% endif %}
</div>

<div id="header-wrapper-fixed-bottom"></div>

<div id="job-details">
    <div class="job-details-preloader-js preloader preloader--job">
        <div class="facet-job-loading hide-for-print" role="alert" aria-labelledby="facet-job-loading">
            <div class="show-for-sr"><label id="facet-jobs-loading">Loading job</label></div>
        </div>
    </div>

    <div class="job-details-inner-js">
        <div class="job-details__heading padded-v-small">
            <div class="row">
                <div class="columns padded-v-small job-details__heading-back">
                    <a href="/search/jobs" class="js" id="back-to-search" rel="nofollow">Back to Search Results</a>
                </div>
            </div>
        </div>

        <div class="padded-v-xlarge">
            <div class="row">
                <div class="columns {% if has_sidebar == 'true' %}medium-8 large-9{% endif %} job-details__main">
                    <section>
                        <div class="row">
                            <div class="columns">
                                <h1>{{ job.title | html_safe }}</h1>
                            </div>
                            <div class="columns {% if has_sidebar == 'true' %}large-6{% else %}medium-6{% endif %}">
                                {% unless job.active? %}
                                    <p>This job posting is no longer active.</p>
                                {% endunless %}
                                {% if notice %}
                                    <p>{{ notice }}</p>
                                {% endif %}
                                <p>
                                    {% capture job_location_state_prov_short_no_digit %}{{ job.location.state_prov_short | replace_global_regex: "[\d]", ":::" }}{% endcapture %}
                                    {% if job_location_state_prov_short_no_digit contains ':::' %}
                                        {% capture job_state_prov %}{{ job.location.state_prov }}{% endcapture %}
                                    {% else %}
                                        {% capture job_state_prov %}{{ job.location.state_prov_short }}{% endcapture %}
                                    {% endif %}
                                    <strong>Location</strong>: {{ job.location.city }}{% if job_state_prov != empty %}, {{ job_state_prov }}{% endif %}{% if job.location.country != empty %}, {{ job.location.country }}{% endif %}<br />
                                    <strong>Date Posted</strong>: <time datetime="{{ job.updated_at | date: '%Y-%m-%d' }}">{{ job.updated_at | date: '%b %-d, %Y' }}</time>
                                    {% if job.cfm3 != blank %}<br /><strong>Schedule</strong>: {{ job.cfm3 }}{% endif %}{% comment %}cfm3 is JobType{% endcomment %}
                                    {% if job.remote_work_label != blank %}<br /><strong>Remote</strong>: {{ job.remote_work_label }}{% endif %}
                                </p>
                                <div class="padded-v-medium--- space-small">
                                    <div class="cs_share_container cs_cfix clearfix">
                                        <span class="cs_share_text">Share:</span>
                                        {% comment %}
                                        <span class="cs_share_email--manual">
                                            <a class="cs_email_btn" href="mailto:?body={{ job.title | html_safe | replace: '&amp;','%26' }}%20in%20{{ job.location.city }},%20{{ job.location.state_prov }}:%20{{ root_url }}{{ job.url }}"><span class="show-for-sr">share to e-mail</span></a>
                                        </span>
                                        {% endcomment %}
                                        <span class="cs_share_email"></span>
                                        <span class="cs_share_twitter"></span>
                                        <span class="cs_share_facebook"></span>
                                        <span class="cs_share_linkedin"></span>
                                    </div>
                                </div>
                                {% if is_job_details == 'true' %}
                                    <div class="social-share-url branded-search space-small">
                                        <input type="text" width="50" value="{{ job.default_career_site_referral_url }}" id="social-share-url__input-1-js">
                                        <a href="javascript:void(0);" class="social-share-url__copy-js" rel="nofollow">Copy</a>
                                        {% comment %}Copy to clipboard only works if the input is visible! If it needs to be hidden, position the input off-screen{% endcomment %}
                                    </div>

                                    <div class="space-medium">
                                        {% if job.referral_incentive_amount != blank or job.referral_incentive_description != blank %}
                                            <h2 class="heading-6 space-none">Referral Reward</h2>
                                            <h3>
                                                {% if job.referral_incentive_amount != blank %}
                                                    {% if job.referral_incentive_currency == 'USD' or job.referral_incentive_currency == 'CAD' %}${% elsif job.referral_incentive_currency == 'EUR' %}€{% elsif job.referral_incentive_currency == 'GBP' %}£{% endif %}{{ job.referral_incentive_amount }} ({{ job.referral_incentive_currency }})
                                                {% endif %}
                                                {% if job.referral_incentive_description != blank %}{{ job.referral_incentive_description }}{% endif %}
                                            </h3>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="columns {% if has_sidebar == 'true' %}large-6 large-text-right{% else %}medium-6 medium-text-right{% endif %}">
                                <div class="space-small">
                                    {% if job.active? %}
                                        {% if agency %}
                                            <button class="apply-bottom js branded-button branded-button-1">Submit Candidate</button>
                                        {% else %}
                                            <button class="apply-bottom js branded-button branded-button-1">Apply Now</button>
                                        {% endif %}
                                    {% endif %}

                                </div>
                                <div class="space-medium">
                                    <a href="javascript:savejob();" class="branded-button branded-button-2 hide save-job" rel="nofollow">Save Job</a>
                                    <a href="javascript:savejob();" class="branded-button branded-button-2 hide job-saved" rel="nofollow">Saved</a>
                                    <script>
                                        // Save Jobs functionality
                                        var is_job_saved = false;
                                        var job_index;
                                        var job_saved_message;
                                        var c_jobs_temp = localStorage.getItem('c_jobs') ? JSON.parse(localStorage.getItem('c_jobs')) : [];
                                        var saved_jobs_query;

                                        // Detecting if job has been saved
                                        if (c_jobs_temp.indexOf('{{ job.external_id }}') >= 0) {
                                            $('.job-saved').removeClass('hide');
                                            is_job_saved = true;
                                            job_index = c_jobs_temp.indexOf('{{ job.external_id }}');
                                            $('.saved-jobs-alert__check').toggleClass('removed');
                                        }
                                        else {
                                            is_job_saved = false;
                                            $('.save-job').removeClass('hide');
                                        }

                                        function savejob() {
                                            {% if params['savejob'] == blank %}
                                                {% capture job_url_save %}{{ job.url }}{% if request_fullpath contains '?' %}&{% else %}?{% endif %}savejob=1{% endcapture %}
                                                window.location.replace('{{ job_url_save }}'); 
                                            {% endif %}
                                        }
                                        {% if params['savejob'] == '1' %}
                                            var job_item;
                                            if (is_job_saved == true) {
                                                is_job_saved = false;
                                                c_jobs_temp.splice(job_index,1);
                                                $('.saved-jobs-alert__check').toggleClass('removed');
                                                $('.saved-jobs-alert__message').html('Job has been removed.');
                                            }
                                            else {
                                                is_job_saved = true;
                                                c_jobs_temp.push('{{ job.external_id }}');
                                                $('.saved-jobs-alert__check').toggleClass('removed');
                                                $('.saved-jobs-alert__message').html('Job has been saved!');
                                            }

                                            localStorage.setItem('c_jobs', JSON.stringify(c_jobs_temp));
                                            
                                            $('.saved-jobs-alert-wrapper').fadeIn();
                                            setTimeout(function() {
                                                $('.button-saved').html('Saved');
                                                $('.saved-jobs-alert-wrapper').fadeOut();

                                                {% if request_fullpath contains '?savejob=1' %}
                                                    {% capture savejob_params %}?savejob=1{% endcapture %}
                                                {% else %}
                                                    {% capture savejob_params %}&savejob=1{% endcapture %}
                                                {% endif %}
                                                {% capture job_url_saved %}{{ request_fullpath | remove: savejob_params }}{% endcapture %}
                                                //location.reload();
                                                window.location.replace('{{ job_url_saved }}');
                                            }, 2000);
                                        {% endif %}
                                    </script>
                                </div>

                                {% if is_job_details == 'true' %}
                                    <div id="refer-top" class="js branded-button-outer branded-button-1-outer space-small">
                                        {{ job | link_to_referral:'Refer a Friend' }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="padded-v-medium space-medium">
                            {{ job.description }}
                        </div>

                        <div class="row">
                            <div class="columns {% if has_sidebar == 'true' %}large-6{% else %}medium-6{% endif %}">
                                <div class="padded-v-medium---">
                                    <div class="cs_share_container cs_cfix clearfix space-small">
                                        <span class="cs_share_text">Share:</span>
                                        {% comment %}
                                        <span class="cs_share_email--manual">
                                            <a class="cs_email_btn" href="mailto:?body={{ job.title | html_safe | replace: '&amp;','%26' }}%20in%20{{ job.location.city }},%20{{ job.location.state_prov }}:%20{{ root_url }}{{ job.url }}"><span class="show-for-sr">share to e-mail</span></a>
                                        </span>
                                        {% endcomment %}
                                        <span class="cs_share_email"></span>
                                        <span class="cs_share_twitter"></span>
                                        <span class="cs_share_facebook"></span>
                                        <span class="cs_share_linkedin"></span>
                                        {% if is_job_details == 'true' %}
                                            <script type="text/javascript">CareerSite.Share.init({url: "{{job.default_career_site_referral_url}}"})</script>
                                        {% else %}
                                            <script type="text/javascript">talemetry.share();</script>
                                        {% endif %}
                                    </div>
                                    {% if is_job_details == 'true' %}
                                        <div class="social-share-url branded-search space-small">
                                            <input type="text" width="50" value="{{ job.default_career_site_referral_url }}" id="social-share-url__input-2-js">
                                            <a href="javascript:void(0);" class="social-share-url__copy-js" rel="nofollow">Copy</a>
                                            {% comment %}Copy to clipboard only works if the input is visible! If it needs to be hidden, position the input off-screen{% endcomment %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="columns {% if has_sidebar == 'true' %}large-6 large-text-right{% else %}medium-6- medium-text-right{% endif %}">
                                {% if job.active? %}
                                    {% if agency %}
                                        <a href="javascript:void(0);" class="apply-bottom js branded-button branded-button-1">Submit Candidate</a>
                                    {% else %}
                                        <a href="javascript:void(0);" class="apply-bottom js branded-button branded-button-1">Apply Now</a>
                                    {% endif %}
                                {% endif %}&nbsp;
                            </div>
                        </div>
                    </section>
                </div><!--close .job-details__main-->

                {% if visitor.frequent_job_searches.total_entries > 0 or visitor.recent_job_searches.total_entries > 0 or visitor.recent_jobs.total_entries > 0 %}
                <div class="columns medium-4 large-3 job-details__sidebar">
                    <aside>
                        <div class="padded-v-small space-small">
                            {% if visitor.frequent_job_searches.total_entries > 0 %}
                                {% assign personalization_counter = 0 %}
                                <div class="visitor-item-wrapper space-medium">
                                    <h3 class="heading-6 space-small">Frequent Job Searches</h3>
                                    {% for search_data in visitor.frequent_job_searches %}
                                        {% if search_data.title != 'All Jobs' %}
                                            {% assign personalization_counter = personalization_counter | plus: 1 %}
                                            <div class="visitor-item"><a href="{{ search_data.url }}" rel="nofollow">{{ search_data.title }}</a></div>

                                            {% if personalization_counter > 5 %}
                                                {% break %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                </div><!--close .visitor-item-wrapper-->
                            {% endif %}

                            {% if visitor.recent_job_searches.total_entries > 0 %}
                                {% assign personalization_counter = 0 %}
                                <div class="visitor-item-wrapper space-medium">
                                    <h3 class="heading-6 space-small">Recent Job Searches</h3>
                                    {% for search_data in visitor.recent_job_searches %}
                                        {% if search_data.title != 'All Jobs' %}
                                            {% assign personalization_counter = personalization_counter | plus: 1 %}
                                            <div class="visitor-item"><a href="{{ search_data.url }}" rel="nofollow">{{ search_data.title }}</a></div>

                                            {% if personalization_counter > 5 %}
                                                {% break %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                </div><!--close .visitor-item-wrapper-->
                            {% endif %}

                            {% if visitor.recent_jobs.total_entries > 0 %}
                                <div class="visitor-item-wrapper space-medium">
                                    <h3 class="heading-6 space-small">Recently Viewed Jobs</h3>
                                    {% for job_data in visitor.recent_jobs limit: 5 %}
                                        <div class="visitor-item"><a href="{{job_data.url}}" rel="nofollow">{{ job_data.title }}</a></div>
                                    {% endfor %}
                                </div><!--close .visitor-item-wrapper-->
                            {% endif %}
                        </div><!--close .branded-box-->
                    </aside>
                    {% endif %}
                </div><!--close .job-details__sidebar-->
            </div>
        </div>
    </div><!--close .job-details-inner-js-->

</div><!--close #job-details-->

<script>loadjob();</script>
      
{% page_required_footer %}